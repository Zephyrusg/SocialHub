# OWNER-PROVIDED VALUES. Copy into secrets/runtime.env, chmod 600; never commit.
DATABASE_URL=mysql+pymysql://socialhub_app:REPLACE@mariadb:3306/socialhub?charset=utf8mb4
ENCRYPTION_KEY=FRESH_PRODUCTION_FERNET_KEY
OAUTH_ISSUER=https://COPY_EXACT_DISCOVERY_ISSUER
OAUTH_JWKS_URL=https://COPY_EXACT_DISCOVERY_JWKS_URI
OAUTH_ALLOWED_SUBJECTS=["VALIDATED_STABLE_OWNER_SUBJECT"]
OAUTH_ALLOWED_CLIENT_IDS=["REGISTERED_MCP_CLIENT_ID"]
# Example only: substitute the actual trusted proxy source address.
TRUSTED_PROXY_CIDRS=["172.28.51.2/32"]
# Only enable live reads AFTER separate production OAuth + permission checks.
META_LIVE_READS=false
META_APP_ID=
META_APP_SECRET=
# Optional portal remains disabled by Compose until independently accepted.
OWNER_OIDC_CLIENT_ID=REGISTERED_SEPARATE_OWNER_CLIENT_ID
OWNER_OIDC_CLIENT_SECRET=OWNER_PROVIDED_SECRET
OWNER_OIDC_ALLOWED_SUBJECTS=["VALIDATED_STABLE_OWNER_SUBJECT"]
OWNER_OIDC_REQUIRE_MFA=true

# Bootstrap identities locally; the admin UI cannot grant itself roles or enable writes.
ADMIN_ENABLED=false
ADMIN_OIDC_CLIENT_ID=REGISTERED_SEPARATE_ADMIN_CLIENT_ID
ADMIN_OIDC_CLIENT_SECRET=OWNER_PROVIDED_ADMIN_SECRET
ADMIN_ALLOWED_SUBJECTS=["VALIDATED_ADMIN_SUBJECT"]
PUBLISHING_ALLOWED_SUBJECTS=["VALIDATED_PUBLISHER_SUBJECT"]
