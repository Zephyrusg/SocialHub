# OWNER-PROVIDED VALUES. Copy into secrets/runtime.env, chmod 600; never commit.
DATABASE_URL=mysql+pymysql://socialhub_app:REPLACE@mariadb:3306/socialhub?charset=utf8mb4
ENCRYPTION_KEY=FRESH_PRODUCTION_FERNET_KEY
OAUTH_ISSUER=https://COPY_EXACT_DISCOVERY_ISSUER
OAUTH_JWKS_URL=https://COPY_EXACT_DISCOVERY_JWKS_URI
OAUTH_ALLOWED_SUBJECTS=["VALIDATED_STABLE_OWNER_SUBJECT"]
OAUTH_ALLOWED_CLIENT_IDS=["REGISTERED_MCP_CLIENT_ID"]
# Example only: substitute the actual trusted proxy source address.
TRUSTED_PROXY_CIDRS=["172.28.51.2/32"]
# Only enable live reads AFTER separate production OAuth + permission checks.
META_LIVE_READS=false
# Deny all writes by default. Explicit Facebook-only preparation: ["pixelpapa-facebook"].
META_WRITE_ACCOUNT_IDS=[]
META_APP_ID=
META_APP_SECRET=
# Optional portal remains disabled by Compose until independently accepted.
OWNER_OIDC_CLIENT_ID=REGISTERED_SEPARATE_OWNER_CLIENT_ID
OWNER_OIDC_CLIENT_SECRET=OWNER_PROVIDED_SECRET
OWNER_OIDC_ALLOWED_SUBJECTS=["VALIDATED_STABLE_OWNER_SUBJECT"]
OWNER_OIDC_REQUIRE_MFA=true

# Bootstrap identities locally; the admin UI cannot grant itself roles or enable writes.
ADMIN_ENABLED=false
ADMIN_OIDC_CLIENT_ID=REGISTERED_SEPARATE_ADMIN_CLIENT_ID
ADMIN_OIDC_CLIENT_SECRET=OWNER_PROVIDED_ADMIN_SECRET
ADMIN_ALLOWED_SUBJECTS=["VALIDATED_ADMIN_SUBJECT"]
PUBLISHING_ALLOWED_SUBJECTS=["VALIDATED_PUBLISHER_SUBJECT"]

# Optional explicit chat-directive policy; owner_required remains the default.
# See docs/chat-first-approval.md. Do not assert native confirmation was tested.
CHATGPT_DIRECT_TESTED=false
CHATGPT_DIRECT_EVIDENCE_SHA256=

# Phase 3D: activate only after actual host-transfer checks and operator approval.
MEDIA_INGESTION_ENABLED=false
MEDIA_ATTACHMENT_PROBE_ENABLED=false
MEDIA_DOWNLOAD_HOSTS=[]
FACEBOOK_MEDIA_PUBLISHING_ENABLED=false
FACEBOOK_MEDIA_ALLOWED_TYPES=["image","video"]
INSTAGRAM_REELS_PUBLISHING_ENABLED=false
MEDIA_STORAGE_MAX_BYTES=536870912
MEDIA_STORAGE_MAX_FILES=16
MEDIA_MIN_FREE_BYTES=67108864
MEDIA_RETENTION_SECONDS=86400
MEDIA_RECEIVE_TIMEOUT_SECONDS=120
MEDIA_CLEANUP_INTERVAL_SECONDS=60
MEDIA_STALE_UPLOAD_SECONDS=600
MEDIA_IMAGE_MAX_PIXELS=16000000

# Phase 3F: independent Google/YouTube provider, disabled at deployment by default.
# Supply Google client credentials privately through Connections, never in Git.
YOUTUBE_ENABLED=false
YOUTUBE_CHANNEL_IDS=[]
YOUTUBE_WRITE_ACCOUNT_IDS=[]
YOUTUBE_PUBLISHING_ENABLED=false
YOUTUBE_SHORTS_ENABLED=false
YOUTUBE_VIDEOS_ENABLED=false
YOUTUBE_UPLOAD_CHUNK_BYTES=8388608
# Existing storage/size ceilings still apply. Review any increase independently.
MEDIA_MAX_VIDEO_SECONDS=600
