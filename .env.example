# Generate independent secrets; never commit .env.
DATABASE_URL=mysql+pymysql://socialhub:REPLACE_WITH_RANDOM_HEX@host.docker.internal:3306/socialhub?charset=utf8mb4
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
AUTH_MODE=local
LOCAL_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PUBLIC_URL=http://localhost:8787/mcp
OAUTH_ISSUER=https://identity.invalid/
OAUTH_AUDIENCE=http://localhost:8787/mcp
OAUTH_JWKS_URL=
MEDIA_ROOT=/data/media

# Configure securely with scripts/configure_meta.py; real values go in ignored secrets/meta.env.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
META_REDIRECT_URI=https://localhost:8788/meta/oauth/callback
META_LIVE_READS=false
META_LIVE_WRITES=false
# Empty denies all publication targets. Facebook-only: ["pixelpapa-facebook"].
META_WRITE_ACCOUNT_IDS=[]
# Facebook Login verifies Professional linkage; Creator/Business subtype is owner-declared.
META_INSTAGRAM_ACCOUNT_TYPE=creator

# Phase 2B: leave both OFF during development; an exact owner-issued approval is also required.
PUBLISHING_ENABLED=false
# META_LIVE_WRITES remains false above.
# Future explicitly reachable HTTPS route for Meta URL ingestion; no tunnel is configured in WSL.
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_BYTES=104857600

# Phase 2D: ChatGPT is the preferred UI; independent owner enforcement remains default.
APPROVAL_MODE=owner_required
APPROVAL_PORTAL_ENABLED=false
# Native-policy activation is an explicit operator security decision after real host tests.
CHATGPT_CONFIRMATION_TESTED=false
CHATGPT_CONFIRMATION_EVIDENCE_SHA256=
CHATGPT_RESIDUAL_RISK_ACCEPTED=false
CHATGPT_ALLOWED_CLIENT_IDS=[]
CHATGPT_ALLOWED_PRINCIPALS=[]
# Message overwrites stay owner-only unless separately included after review.
CHATGPT_ALLOWED_OPERATIONS=["publish","reply"]

# Phase 3A.1: exact configured origins, no URL prefix rewriting.
BROWSER_ORIGIN=https://localhost:8788
TRUSTED_PROXY_CIDRS=["127.0.0.1/32"]
# OAuth defaults deny every subject/client until explicitly bound to discovery-verified identities.
OAUTH_ALLOWED_SUBJECTS=[]
OAUTH_ALLOWED_CLIENT_IDS=[]
OWNER_OIDC_ENABLED=false
OWNER_OIDC_CLIENT_ID=
OWNER_OIDC_CLIENT_SECRET=
OWNER_OIDC_ALLOWED_SUBJECTS=[]
OWNER_OIDC_REQUIRE_MFA=true
# Read-only production Compose explicitly overrides this to false.
MEDIA_DELIVERY_ENABLED=true

# Optional administration: existing OIDC identities; no separate user passwords.
ADMIN_ENABLED=false
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_CLIENT_SECRET=
ADMIN_ALLOWED_SUBJECTS=[]
# Separate permission: an administrator is not automatically a publisher.
PUBLISHING_ALLOWED_SUBJECTS=[]

# Optional explicit chat-directive policy; owner_required remains the default.
# See docs/chat-first-approval.md. Do not assert native confirmation was tested.
CHATGPT_DIRECT_TESTED=false
CHATGPT_DIRECT_EVIDENCE_SHA256=

# Phase 3D: activate only after actual host-transfer checks and operator approval.
MEDIA_INGESTION_ENABLED=false
MEDIA_ATTACHMENT_PROBE_ENABLED=false
MEDIA_DOWNLOAD_HOSTS=[]
FACEBOOK_MEDIA_PUBLISHING_ENABLED=false
FACEBOOK_MEDIA_ALLOWED_TYPES=["image","video"]
# Reels upload private MP4 bytes directly to Meta; signed delivery is not needed.
# Also requires explicit account allowlisting, global write switches and approval.
INSTAGRAM_REELS_PUBLISHING_ENABLED=false
# Resolved into each NEW immutable Reel preview; not a write/approval switch.
REELS_AI_GENERATED_DEFAULT=true
MEDIA_STORAGE_MAX_BYTES=536870912
MEDIA_STORAGE_MAX_FILES=16
MEDIA_MIN_FREE_BYTES=67108864
MEDIA_RETENTION_SECONDS=86400
MEDIA_RECEIVE_TIMEOUT_SECONDS=120
MEDIA_CLEANUP_INTERVAL_SECONDS=60
MEDIA_STALE_UPLOAD_SECONDS=600
MEDIA_IMAGE_MAX_PIXELS=16000000
